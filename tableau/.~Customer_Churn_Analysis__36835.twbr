                  <zone h='65131' id='17' name='Churn by Tenure' w='51230' x='48133' y='5603'>
                    <layout-cache cell-count-w='6' minheight='204' non-cell-size-w='81' type-h='scalable' type-w='cell' />
                    <zone-style>
                      <format attr='border-color' value='#444444' />
                      <format attr='border-style' value='none' />
